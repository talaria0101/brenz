{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Brenz builtin functions and methods doc schema",
  "type": "object",
  "properties": {
    "functions": {
      "type": "object",
      "description": "Map of function name -> function descriptor",
      "patternProperties": {
        "^.*$": { "$ref": "#/definitions/functionDef" }
      },
      "additionalProperties": false
    },
    "methods": {
      "type": ["object", "null"],
      "description": "Map of method name -> method descriptor (has `called_on`)",
      "patternProperties": {
        "^.*$": { "$ref": "#/definitions/methodDef" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true,
  "definitions": {
    "paramDef": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string", "description": "type name (string, vector, entity, any, etc.)" },
        "info": { "type": "string" }
      },
      "additionalProperties": false
    },
    "functionDef": {
      "type": "object",
      "required": ["sign", "info", "params"],
      "properties": {
        "camel_name": { "type": ["string", "null"], "description": "camelCase variant of the function name" },
        "sign": { "type": "string", "description": "signature string like: spawn(classname, origin)" },
        "info": { "type": "string" },
        "params": { "type": "array", "items": { "$ref": "#/definitions/paramDef" } },
        "returns": { "type": ["string", "null"] },
        "example": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "methodDef": {
      "type": "object",
      "required": ["sign", "called_on", "info", "params"],
      "properties": {
        "camel_name": { "type": ["string", "null"], "description": "camelCase variant of the method name" },
        "sign": { "type": "string", "description": "signature string like: setHealth(amount)" },
        "called_on": {
          "type": "string",
          "description": "type or object the method is called on (e.g. 'player', 'entity', 'thread')"
        },
        "info": { "type": "string" },
        "params": { "type": "array", "items": { "$ref": "#/definitions/paramDef" } },
        "returns": { "type": ["string", "null"] },
        "example": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  }
}
